# ============================================================
# Recon Framework - Core Library
# Common functions, logging, error handling, utilities
# ============================================================

# Strict mode for library
set -euo pipefail

# ─── Color definitions ───────────────────────────────────────
if [[ -t 1 ]]; then
    readonly RED='\033[0;31m'
    readonly GREEN='\033[0;32m'
    readonly YELLOW='\033[1;33m'
    readonly CYAN='\033[0;36m'
    readonly BLUE='\033[0;34m'
    readonly MAGENTA='\033[0;35m'
    readonly BOLD='\033[1m'
    readonly NC='\033[0m'
else
    readonly RED='' GREEN='' YELLOW='' CYAN='' BLUE='' MAGENTA='' BOLD='' NC=''
fi

# ─── Global state ────────────────────────────────────────────
declare -g LOG_FILE=""
declare -g OUTPUT_DIR=""
declare -g TARGET=""
declare -g DOMAIN=""
declare -g REAL_IP=""
declare -g SCAN_MODE="quick"
declare -g AUTHENTICATED=0
declare -a AUTH_HEADERS=()
declare -a HDR_H=()
declare -a DALFOX_AUTH=()
declare -a ARJUN_HDRS=()
declare -a CURL_AUTH=()
declare -a SQLMAP_AUTH=()

# ─── Logging functions ───────────────────────────────────────

log_init() {
    local log_file="$1"
    LOG_FILE="$log_file"
    mkdir -p "$(dirname "$LOG_FILE")"

    # Save original stdout/stderr, then redirect through tee
    # This lets us log colored output to terminal AND clean text to file
    exec 3>&1 4>&2
    exec > >(tee >(sed -u 's/\x1b\[[0-9;]*m//g' >> "$LOG_FILE")) 2>&1
}

log_section() {
    local title="$1"
    echo ""
    echo -e "${BLUE}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}${BOLD}  ${title}${NC}"
    echo -e "${BLUE}${BOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
}

log_info()  { echo -e "${CYAN}[*] $*${NC}"; }
log_ok()    { echo -e "${GREEN}[+] $*${NC}"; }
log_warn()  { echo -e "${YELLOW}[!] $*${NC}"; }
log_error() { echo -e "${RED}[!] $*${NC}"; }
log_vuln()  { echo -e "${RED}${BOLD}[VULN] $*${NC}"; }

# ─── Utility functions ───────────────────────────────────────

# Safe count that returns clean integer
safe_count() {
    local file="$1" pattern="${2:-}"
    [[ -f "$file" ]] || { echo 0; return; }
    local count
    if [[ -n "$pattern" ]]; then
        count=$(grep -cE "$pattern" "$file" 2>/dev/null || echo 0)
    else
        count=$(wc -l < "$file" 2>/dev/null || echo 0)
    fi
    echo "${count:-0}" | tr -dc '0-9'
}

# Check if tool exists (executable binary only, not shell functions/aliases)
check_tool() {
    type -P "$1" &>/dev/null
}

# Run with timeout and retry
run_with_retry() {
    local max_attempts="${1:-3}"
    local timeout_sec="${2:-30}"
    shift 2
    local cmd=("$@")
    local attempt=1

    while [[ $attempt -le $max_attempts ]]; do
        if timeout "$timeout_sec" "${cmd[@]}"; then
            return 0
        fi
        log_warn "Command failed (attempt $attempt/$max_attempts): ${cmd[*]}"
        ((attempt++))
        sleep 2
    done
    return 1
}

# Parallel execution with job control
parallel_exec() {
    local max_jobs="${1:-4}"
    shift
    local -a pids=()
    local -a commands=("$@")

    for cmd in "${commands[@]}"; do
        while [[ ${#pids[@]} -ge $max_jobs ]]; do
            for i in "${!pids[@]}"; do
                if ! kill -0 "${pids[i]}" 2>/dev/null; then
                    wait "${pids[i]}" 2>/dev/null || true
                    unset 'pids[i]'
                fi
            done
            pids=("${pids[@]}")  # reindex
            sleep 0.5
        done
        bash -c "$cmd" &
        pids+=($!)
    done

    for pid in "${pids[@]}"; do
        wait "$pid" 2>/dev/null || true
    done
}

# Check if IP is in CIDR ranges
is_cdn_ip() {
    local ip="$1"
    local ranges_file="$2"
    [[ -s "$ranges_file" ]] || return 1
    python3 - "$ip" "$ranges_file" <<'PY' 2>/dev/null
import ipaddress, sys
ip = sys.argv[1]
try: addr = ipaddress.ip_address(ip)
except ValueError: sys.exit(1)
try:
    for line in open(sys.argv[2]):
        line = line.strip()
        if not line: continue
        try:
            if addr in ipaddress.ip_network(line, strict=False): sys.exit(0)
        except ValueError: continue
except OSError: pass
sys.exit(1)
PY
}

# Validate IPv4 address
is_valid_ipv4() {
    local ip="$1"
    [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
    local IFS='.'
    read -r a b c d <<< "$ip"
    [[ $a -le 255 && $b -le 255 && $c -le 255 && $d -le 255 ]]
}

# Clean temp files on exit
cleanup_temp() {
    local output_dir="${1:-}"
    # Clean up temp files created by our background jobs (info_disclosure, etc.)
    # Patterns: .id_*, .err_*, .trg_* (unique per-run temp dirs/files)
    find /tmp -maxdepth 1 -name ".id_*" -user "$(whoami)" -mmin +60 -delete 2>/dev/null || true
    find /tmp -maxdepth 1 -name ".err_*" -user "$(whoami)" -mmin +60 -delete 2>/dev/null || true
    find /tmp -maxdepth 1 -name ".trg_*" -user "$(whoami)" -mmin +60 -delete 2>/dev/null || true
    find /tmp -maxdepth 1 -name ".recon_*" -user "$(whoami)" -mmin +60 -delete 2>/dev/null || true
    # Clean up interactsh temp files
    find /tmp -maxdepth 1 -name ".oob_*" -user "$(whoami)" -mmin +60 -delete 2>/dev/null || true
}

# Sanitize string for filename
sanitize_filename() {
    local str="$1"
    echo "$str" | tr -c 'a-zA-Z0-9._-' '_'
}

# Download file if not cached
download_if_missing() {
    local url="$1"
    local dest="$2"
    local max_age_days="${3:-7}"

    if [[ -s "$dest" && -n "$(find "$dest" -mtime -"$max_age_days" 2>/dev/null)" ]]; then
        return 0
    fi

    log_info "Downloading: $url"
    mkdir -p "$(dirname "$dest")"
    if ! curl -sL --max-time 30 "$url" -o "$dest" 2>/dev/null; then
        log_warn "Failed to download: $url"
        return 1
    fi
    return 0
}

# Step execution control
should_run_step() {
    local step="$1"
    [[ "${STEPS_ARG:-all}" == "all" ]] && return 0
    IFS=',' read -ra STEP_LIST <<< "${STEPS_ARG}"
    for s in "${STEP_LIST[@]}"; do
        if [[ "$s" == *"-"* ]]; then
            # Handle range format: start-end
            local start="${s%-*}"
            local end="${s#*-}"
            if [[ "$step" -ge "$start" && "$step" -le "$end" ]]; then
                return 0
            fi
        elif [[ "$s" == "$step" ]]; then
            return 0
        fi
    done
    return 1
}

# Nmap timing based on scan mode
get_nmap_timing() {
    case "${SCAN_MODE}" in
        stealth) echo "-T2" ;;
        full)    echo "-T4" ;;
        *)       echo "-T4" ;;
    esac
}

# Safe DNS resolution falling back to public resolvers on timeout/failure
safe_dig() {
    local qtype="$1"
    local qname="$2"
    local resolver="${3:-}"
    local output
    if [[ -n "$resolver" ]]; then
        dig +short "$qtype" "$qname" "$resolver" 2>/dev/null | grep -v '^;'
    else
        output=$(dig +short "$qtype" "$qname" 2>/dev/null | grep -v '^;')
        if [[ -z "$output" ]]; then
            for res in "1.1.1.1" "8.8.8.8" "9.9.9.9"; do
                output=$(dig +short "@$res" "$qtype" "$qname" 2>/dev/null | grep -v '^;')
                if [[ -n "$output" ]]; then
                    break
                fi
            done
        fi
        echo "$output"
    fi
}
# ============================================================
# False-Positive Reduction Helpers (added v11.1)
# Shared primitives so vuln checks confirm findings with real
# evidence instead of matching common words or bare HTTP 200s.
# ============================================================

# Fetch body (globoff, bounded, auth headers applied).
fp_body() { local url="$1"; shift; curl -skg --max-time 8 ${CURL_AUTH[@]+${CURL_AUTH[@]+"${CURL_AUTH[@]}"}} "$@" "$url" 2>/dev/null; }

# Fetch status code only.
fp_code() { local url="$1"; shift; curl -skg -o /dev/null -w '%{http_code}' --max-time 8 ${CURL_AUTH[@]+${CURL_AUTH[@]+"${CURL_AUTH[@]}"}} "$@" "$url" 2>/dev/null || echo 000; }

declare -gA _FP_S404_CODE=()
declare -gA _FP_S404_SIZE=()

_fp_origin() { echo "$1" | sed -E 's#(https?://[^/]+).*#\1#'; }

# Learn how the origin responds to a definitely-nonexistent path (soft-404 detection).
fp_soft404_baseline() {
    local origin; origin="$(_fp_origin "$1")"
    [[ -n "${_FP_S404_CODE[$origin]:-}" ]] && return 0
    local rp="/zz${RANDOM}${RANDOM}-nope-${RANDOM}.html"
    local out; out=$(curl -skg -o /dev/null -w '%{http_code} %{size_download}' --max-time 8 ${CURL_AUTH[@]+${CURL_AUTH[@]+"${CURL_AUTH[@]}"}} "${origin}${rp}" 2>/dev/null || echo "000 0")
    _FP_S404_CODE[$origin]="${out%% *}"
    _FP_S404_SIZE[$origin]="${out##* }"
}

# True only if <url> returns 200 AND looks materially different from the origin's
# soft-404 page. Prevents "everything returns 200" sites from tripping path checks.
fp_real_200() {
    local url="$1" origin; origin="$(_fp_origin "$url")"
    fp_soft404_baseline "$url"
    local out code size; out=$(curl -skg -o /dev/null -w '%{http_code} %{size_download}' --max-time 8 ${CURL_AUTH[@]+${CURL_AUTH[@]+"${CURL_AUTH[@]}"}} "$url" 2>/dev/null || echo "000 0")
    code="${out%% *}"; size="${out##* }"
    [[ "$code" == "200" ]] || return 1
    if [[ "${_FP_S404_CODE[$origin]:-}" == "200" ]]; then
        local s4="${_FP_S404_SIZE[$origin]:-0}"
        local diff=$(( size > s4 ? size - s4 : s4 - size ))
        [[ "$s4" -gt 0 && "$diff" -lt $(( s4 / 5 )) ]] && return 1
        [[ "$diff" -lt 64 ]] && return 1
    fi
    return 0
}

# True if <url> is a real 200 AND body matches a REQUIRED content signature (ERE).
# Use this for file/endpoint exposure checks instead of status==200 alone.
fp_confirm_content() {
    local url="$1" sig="$2"
    fp_real_200 "$url" || return 1
    fp_body "$url" | grep -qiE "$sig"
}

# ============================================================
# Framework Upgrades (v11.2): param injection, structured findings,
# redaction, throttling, scope control, reporting.
# ============================================================

# ── Parameter helpers (replace the copy-pasted split/rebuild blocks) ──
# Echo each parameter KEY of a URL query string, one per line.
param_keys() {
    local url="$1"; local query="${url#*\?}"
    [[ "$url" == *\?* ]] || return 0
    local IFS='&'; local kv
    for kv in $query; do
        [[ -z "$kv" ]] && continue
        echo "${kv%%=*}"
    done
}

# Rebuild <url> with <key> set to <value> (replacing that key's value, others intact).
# Usage: newurl=$(set_param "$url" "$key" "$payload")
set_param() {
    local url="$1" tkey="$2" tval="$3"
    local base="${url%%\?*}" query="${url#*\?}"
    [[ "$url" == *\?* ]] || { echo "$url"; return; }
    local out=() IFS='&' kv k
    for kv in $query; do
        [[ -z "$kv" ]] && continue
        k="${kv%%=*}"
        if [[ "$k" == "$tkey" ]]; then out+=("${k}=${tval}"); else out+=("$kv"); fi
    done
    local joined; joined=$(IFS='&'; echo "${out[*]}")
    echo "${base}?${joined}"
}

# ── Redaction: strip secrets from anything written to findings/logs ──
redact() {
    sed -E \
      -e 's/([Cc]ookie:[[:space:]]*)[^"[:space:]]+/\1[REDACTED]/g' \
      -e 's/(([Aa]uthorization|[Tt]oken|api[_-]?key|access[_-]?token|secret)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"']?)[A-Za-z0-9._-]{6,}/\1[REDACTED]/g'
}

# ── Structured findings with a confidence level ──
# record_finding <check> <severity> <confidence> <url> <evidence...>
#   confidence: CONFIRMED | LIKELY | REVIEW | INFO
# Writes a JSON line to $OUTPUT_DIR/findings.jsonl and logs at the right level.
record_finding() {
    local check="$1" severity="$2" confidence="$3" url="$4"; shift 4
    local evidence="$*"
    local ev_red; ev_red=$(printf '%s' "$evidence" | redact)
    local url_red; url_red=$(printf '%s' "$url" | redact)
    local jf="${OUTPUT_DIR:-.}/findings.jsonl"
    # minimal JSON escaping
    _je() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e ':a;N;$!ba;s/\n/\\n/g'; }
    printf '{"ts":"%s","check":"%s","severity":"%s","confidence":"%s","url":"%s","evidence":"%s"}\n' \
        "$(date -Iseconds 2>/dev/null || date)" "$(_je "$check")" "$(_je "$severity")" \
        "$(_je "$confidence")" "$(_je "$url_red")" "$(_je "$ev_red")" >> "$jf" 2>/dev/null || true
    case "$confidence" in
        CONFIRMED) log_vuln "[$check/$severity] $url_red — $ev_red" ;;
        LIKELY)    log_vuln "[$check/$severity/LIKELY] $url_red — $ev_red" ;;
        REVIEW)    log_warn "[$check/REVIEW] $url_red — $ev_red (manual verification)" ;;
        *)         log_info "[$check/INFO] $url_red — $ev_red" ;;
    esac
}

# ── Throttling: politeness + avoid tripping WAFs/rate limits ──
declare -g THROTTLE_DELAY="${THROTTLE_DELAY:-0}"
set_throttle_for_mode() {
    case "${SCAN_MODE:-quick}" in
        stealth) THROTTLE_DELAY="0.5" ;;
        full)    THROTTLE_DELAY="0" ;;
        *)       THROTTLE_DELAY="0.1" ;;
    esac
}
throttle() { [[ "${THROTTLE_DELAY:-0}" != "0" ]] && sleep "$THROTTLE_DELAY" 2>/dev/null || true; }

# ── Scope control: keep the scan inside authorized hosts ──
# SCOPE_FILE format: one host/regex per line; lines starting with '!' are denies.
declare -g SCOPE_FILE="${SCOPE_FILE:-}"
in_scope() {
    local host="$1"
    [[ -z "${SCOPE_FILE:-}" || ! -f "$SCOPE_FILE" ]] && return 0   # no scope file => allow
    # explicit deny wins
    local line
    while IFS= read -r line; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        if [[ "$line" == !* ]]; then
            [[ "$host" =~ ${line#!} ]] && return 1
        fi
    done < "$SCOPE_FILE"
    # must match at least one allow
    while IFS= read -r line; do
        [[ -z "$line" || "$line" == \#* || "$line" == !* ]] && continue
        [[ "$host" =~ $line ]] && return 0
    done < "$SCOPE_FILE"
    return 1
}

# ── Report: human-readable summary from findings.jsonl (CONFIRMED first) ──
generate_findings_report() {
    local jf="${OUTPUT_DIR:-.}/findings.jsonl"
    local rf="${OUTPUT_DIR:-.}/findings_report.md"
    [[ -s "$jf" ]] || { echo "# Findings\n\nNo structured findings recorded." > "$rf"; return; }
    python3 - "$jf" "$rf" << 'PY' 2>/dev/null || true
import json,sys,collections
jf,rf=sys.argv[1],sys.argv[2]
rows=[]
for l in open(jf):
    l=l.strip()
    if not l: continue
    try: rows.append(json.loads(l))
    except: pass
order={"CONFIRMED":0,"LIKELY":1,"REVIEW":2,"INFO":3}
rows.sort(key=lambda r:(order.get(r.get("confidence","INFO"),9), r.get("check","")))
by=collections.Counter(r.get("confidence","INFO") for r in rows)
with open(rf,"w") as f:
    f.write("# Recon Findings Report\n\n")
    f.write("## Summary\n\n")
    for k in ["CONFIRMED","LIKELY","REVIEW","INFO"]:
        if by.get(k): f.write(f"- **{k}**: {by[k]}\n")
    f.write("\n> Triage CONFIRMED first. REVIEW items need manual verification before reporting.\n\n")
    cur=None
    for r in rows:
        c=r.get("confidence","INFO")
        if c!=cur:
            f.write(f"\n## {c}\n\n"); cur=c
        f.write(f"- `{r.get('check')}` [{r.get('severity')}] {r.get('url')}\n")
        if r.get("evidence"): f.write(f"    - evidence: {r.get('evidence')}\n")
        u=r.get("url","")
        if u.startswith("http"): f.write(f"    - repro: `curl -skg -i '{u}'`\n")
PY
    log_ok "Findings report: $rf"
}
